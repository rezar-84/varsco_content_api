<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ Categories ============ -->

    <record id="varsco_catalog_category_view_list" model="ir.ui.view">
        <field name="name">varsco.catalog.category.view.list</field>
        <field name="model">varsco.catalog.category</field>
        <field name="arch" type="xml">
            <list string="Catalog Categories">
                <field name="sequence" widget="handle"/>
                <field name="slug"/>
                <field name="url_path"/>
                <field name="parent_id"/>
                <field name="published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="varsco_catalog_category_view_form" model="ir.ui.view">
        <field name="name">varsco.catalog.category.view.form</field>
        <field name="model">varsco.catalog.category</field>
        <field name="arch" type="xml">
            <form string="Catalog Category">
                <sheet>
                    <group>
                        <group>
                            <field name="slug" placeholder="e.g. live-feed"/>
                            <field name="url_path" placeholder="e.g. products/live-feed"/>
                        </group>
                        <group>
                            <field name="parent_id"/>
                            <field name="sequence"/>
                            <field name="published"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Translations" name="translations">
                            <p class="text-muted">
                                A category is only servable to the public API in a given locale
                                once its translation here has Review Status = Reviewed, and
                                Name/Meta Title/Meta Description are all filled in.
                            </p>
                            <field name="translation_ids">
                                <list editable="bottom">
                                    <field name="locale_id"/>
                                    <field name="name"/>
                                    <field name="summary"/>
                                    <field name="meta_title"/>
                                    <field name="meta_description"/>
                                    <field name="review_status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="varsco_catalog_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">varsco.catalog.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a catalog category</p>
        </field>
    </record>

    <!-- ============ Products (catalog items) ============ -->

    <record id="varsco_catalog_item_view_list" model="ir.ui.view">
        <field name="name">varsco.catalog.item.view.list</field>
        <field name="model">varsco.catalog.item</field>
        <field name="arch" type="xml">
            <list string="Catalog Products">
                <field name="sequence" widget="handle"/>
                <field name="slug"/>
                <field name="category_id"/>
                <field name="item_type"/>
                <field name="published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="varsco_catalog_item_view_form" model="ir.ui.view">
        <field name="name">varsco.catalog.item.view.form</field>
        <field name="model">varsco.catalog.item</field>
        <field name="arch" type="xml">
            <form string="Catalog Product">
                <sheet>
                    <group>
                        <group>
                            <field name="slug" placeholder="e.g. artemia-cysts-500g"/>
                            <field name="url_path" placeholder="e.g. products/live-feed/artemia-cysts-500g"/>
                            <field name="category_id"/>
                        </group>
                        <group>
                            <field name="item_type"/>
                            <field name="product_template_ids"
                                   widget="many2many_tags"
                                   invisible="item_type != 'purchasable_now'"
                                   options="{'no_create': True}"/>
                            <field name="sequence"/>
                            <field name="published"/>
                            <field name="quote_cta_enabled"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Translations" name="translations">
                            <p class="text-muted">
                                A product is only servable to the public API in a given locale
                                once its translation here has Review Status = Reviewed, and
                                Name/Meta Title/Meta Description are all filled in, and its
                                category is servable too.
                            </p>
                            <field name="translation_ids">
                                <list>
                                    <field name="locale_id"/>
                                    <field name="name"/>
                                    <field name="meta_title"/>
                                    <field name="review_status"/>
                                </list>
                                <form string="Product Translation">
                                    <group>
                                        <group>
                                            <field name="locale_id"/>
                                            <field name="review_status"/>
                                        </group>
                                    </group>
                                    <group>
                                        <field name="name"/>
                                        <field name="eyebrow"/>
                                        <field name="summary"/>
                                        <field name="meta_title"/>
                                        <field name="meta_description"/>
                                    </group>
                                    <group string="Description">
                                        <field name="description_html" widget="html" nolabel="1"/>
                                    </group>
                                    <group string="Media (JSON list of {url, alt})">
                                        <field name="media" widget="text" nolabel="1"/>
                                    </group>
                                    <group string="Specification groups (JSON — see models/catalog.py docstring for shape)">
                                        <field name="specification_groups" widget="text" nolabel="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="varsco_catalog_item_action" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">varsco.catalog.item</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a catalog product</p>
        </field>
    </record>

    <!-- ============ Menu ============ -->

    <menuitem id="varsco_content_api_menu_root" name="Varsco Catalog" sequence="60" groups="base.group_system"/>
    <menuitem id="varsco_content_api_menu_products" name="Products" parent="varsco_content_api_menu_root" action="varsco_catalog_item_action" sequence="10"/>
    <menuitem id="varsco_content_api_menu_categories" name="Categories" parent="varsco_content_api_menu_root" action="varsco_catalog_category_action" sequence="20"/>

</odoo>
